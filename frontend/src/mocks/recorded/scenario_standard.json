    "parameters": [
      {
        "name": "workday",
        "value": 480.0,
        "unit": "min",
        "kind": "assumed",
        "derivation": "One 8-hour crew day",
        "source": null
      },
      {
        "name": "install_duration",
        "value": "180/210/240",
        "unit": "min",
        "kind": "assumed",
        "derivation": "Onsite battery retrofit of 3 to 4 hours, drawn uniformly per job (seeded)",
        "source": null
      },
      {
        "name": "ready_dates",
        "value": 5.0,
        "unit": "business days",
        "kind": "synthetic",
        "derivation": "Each job becomes ready on a uniform random day in the first N business days",
        "source": null
      },
      {
        "name": "deadline_rule",
        "value": 5.0,
        "unit": "business days",
        "kind": "assumed",
        "derivation": "Deadline = ready date + N business days, capped at the last window day",
        "source": null
      },
      {
        "name": "business_days",
        "value": "weekdays",
        "unit": "",
        "kind": "assumed",
        "derivation": "Crews work weekdays that are not US federal holidays",
        "source": null
      },
      {
        "name": "overflow_days",
        "value": 0.0,
        "unit": "business days",
        "kind": "assumed",
        "derivation": "Crew days after the window where late jobs can still land",
        "source": null
      },
      {
        "name": "current_plan_rule",
        "value": "EDF",
        "unit": "",
        "kind": "derived",
        "derivation": "Current plan = earliest-deadline-first booking in the window, day 0 locked",
        "source": null
      },
      {
        "name": "depot",
        "value": "-95.4200,29.7467",
        "unit": "lon,lat",
        "kind": "assumed",
        "derivation": "Crew yard at the mean of the cluster centers",
        "source": null
      },
      {
        "name": "road_circuity",
        "value": 1.417,
        "unit": "ratio",
        "kind": "assumed",
        "derivation": "US nationwide driving distance / straight-line distance",
        "source": "Boscoe, Henry, Zdeb (2012). A Nationwide Comparison of Driving Distance Versus Straight-Line Distance to Hospitals. The Professional Geographer 64(2):188-196."
      },
      {
        "name": "average_speed",
        "value": 40.0,
        "unit": "km/h",
        "kind": "assumed",
        "derivation": "Urban driving including stops",
        "source": null
      },
      {
        "name": "travel_N",
        "value": 34.0,
        "unit": "min",
        "kind": "derived",
        "derivation": "(2 x depot-to-center + 2 x mean site radius) x circuity / speed, depot distance 7.30 km",
        "source": null
      },
      {
        "name": "travel_S",
        "value": 41.0,
        "unit": "min",
        "kind": "derived",
        "derivation": "(2 x depot-to-center + 2 x mean site radius) x circuity / speed, depot distance 8.85 km",
        "source": null
      },
      {
        "name": "travel_W",
        "value": 32.0,
        "unit": "min",
        "kind": "derived",
        "derivation": "(2 x depot-to-center + 2 x mean site radius) x circuity / speed, depot distance 6.77 km",
        "source": null
      },
      {
        "name": "deliveries",
        "value": 3.0,
        "unit": "business days",
        "kind": "assumed",
        "derivation": "A delivery every N business days, sized to the planned installs until the next",
        "source": null
      },
      {
        "name": "battery_capacity",
        "value": 13.5,
        "unit": "kWh",
        "kind": "observed",
        "derivation": "Powerwall 3 nominal battery energy (13.5 kWh AC)",
        "source": "https://energylibrary.tesla.com/docs/Public/EnergyStorage/Powerwall/3/Datasheet/en-us/Powerwall-3-Datasheet.pdf"
      },
      {
        "name": "battery_charge_limit",
        "value": 5.0,
        "unit": "kW",
        "kind": "observed",
        "derivation": "Powerwall 3 maximum continuous charge power",
        "source": "https://energylibrary.tesla.com/docs/Public/EnergyStorage/Powerwall/3/Datasheet/en-us/Powerwall-3-Datasheet.pdf"
      },
      {
        "name": "battery_discharge_limit",
        "value": 11.5,
        "unit": "kW",
        "kind": "observed",
        "derivation": "Powerwall 3 nominal output power, highest rating",
        "source": "https://energylibrary.tesla.com/docs/Public/EnergyStorage/Powerwall/3/Datasheet/en-us/Powerwall-3-Datasheet.pdf"
      },
      {
        "name": "battery_round_trip",
        "value": 0.89,
        "unit": "fraction",
        "kind": "observed",
        "derivation": "Powerwall 3 solar-to-battery-to-home/grid efficiency (typical solar shifting). The datasheet gives no grid-charge figure",
        "source": "https://energylibrary.tesla.com/docs/Public/EnergyStorage/Powerwall/3/Datasheet/en-us/Powerwall-3-Datasheet.pdf"
      },
      {
        "name": "battery_one_way_efficiency",
        "value": 0.943398,
        "unit": "fraction",
        "kind": "derived",
        "derivation": "Charge and discharge efficiency = sqrt(round trip)",
        "source": null
      },
      {
        "name": "battery_reserve",
        "value": 1.35,
        "unit": "kWh",
        "kind": "assumed",
        "derivation": "10% of capacity held back; start and end at reserve",
        "source": null
      },
      {
        "name": "unscheduled_penalty",
        "value": 30.0,
        "unit": "days",
        "kind": "assumed",
        "derivation": "Delay charged for a job left unscheduled; larger than any lateness in the horizon",
